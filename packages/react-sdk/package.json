{
  "name": "@clawface/react-sdk",
  "version": "1.0.0",
  "description": "React SDK for ClawFace — auto-generated forms, tables, and CRUD from schema metadata",
  "main": "dist/react/index.js",
  "types": "dist/react/index.d.ts",
